# Public Neon Auth endpoint; safe to include in the frontend bundle.
VITE_NEON_AUTH_URL=https://your-endpoint.neonauth.your-region.aws.neon.tech/neondb/auth

# Server only. Never prefix this variable with VITE_.
DATABASE_URL=postgresql://user:password@your-host/neondb?sslmode=require

# Server only: comma-separated verified Neon Auth user IDs allowed to triage all reports.
FEEDBACK_ADMIN_IDS=
# Alternatively allow verified email addresses from signed authentication tokens.
FEEDBACK_ADMIN_EMAILS=hiba.p@seznam.cz
